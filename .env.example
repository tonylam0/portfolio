NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# Hero identity + social links
NEXT_PUBLIC_AVATAR_URL=https://example.com/your-photo.jpg
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/your-handle
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-handle
NEXT_PUBLIC_RESUME_URL=https://example.com/your-resume.pdf

# GitHub heatmap
NEXT_PUBLIC_GITHUB_USERNAME=your-handle

# Resend email delivery
RESEND_API_KEY=your_resend_api_key
CONTACT_TO_EMAIL=you@example.com

# Optional: customize the From header (must be a verified sender in Resend)
CONTACT_FROM_EMAIL=you@example.com
CONTACT_FROM_NAME=Portfolio
